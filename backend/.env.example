PORT=5000
MONGODB_URI=your-mongodb-connection-string
MONGODB_DATABASE=Mango
# Con `npm run dev`, nodemon.json pisa esta variable con Mango_dev: el entorno local
# usa una base aparte y nunca toca los datos reales de producción.
NODE_ENV=development

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Session
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Administradores (mails separados por coma): ven y corren las tareas programadas en Configuración.
# Fuera de producción todos los usuarios son admin.
ADMIN_EMAILS=

# Scheduler de jobs diarios dentro del proceso (PLAT-01). Poner false para apagarlo.
SCHEDULER_ENABLED=true

# Clave para cifrar credenciales de terceros (token de Mercado Pago, contraseñas de PDF) con AES-256-GCM.
# 32 bytes en base64. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o se cambia, las credenciales guardadas no se pueden leer y hay que cargarlas de nuevo.
# Con `npm run dev`, nodemon.json usa una clave fija solo para Mango_dev: en producción configurar una propia.
SECRETS_KEY=

# REV-06: sugerencias de categoría con Claude (opcional; sin clave, la opción queda deshabilitada)
ANTHROPIC_API_KEY=
